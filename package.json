{
  "name": "twitchminichatdesktop",
  "productName": "twitchminichatdesktop",
  "version": "1.1.2",
  "description": "TMC desktop chat client",
  "main": ".vite/build/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx,.mjs . --max-warnings 0 --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "test": "tsc --project tsconfig.test.json && node --experimental-test-module-mocks --test tests/*.test.cjs",
    "test:e2e": "node tests/e2e/account-removal.mjs",
    "test:packaged": "node tests/e2e/packaged-smoke.mjs",
    "test:squirrel": "node tests/e2e/squirrel-smoke.mjs",
    "postinstall": "install-electron"
  },
  "keywords": [],
  "author": {
    "name": "unouidol",
    "email": "federico.silenzi@alice.it"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "electron": "43.8.12",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "~5.1.6",
    "vite": "^8.3.8",
    "webdriverio": "10.2.0",
    "ws": "8.23.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true,
    "edgedriver@8.0.0": false,
    "geckodriver@8.0.0": false
  }
}
