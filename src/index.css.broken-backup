import { app, BrowserWindow, ipcMain } from 'electron';
import path from 'node:path';

/**
 * Vite development server URL injected by Electron Forge.
 */
declare const MAIN_WINDOW_VITE_DEV_SERVER_URL: string;

/**
 * Vite renderer bundle name injected by Electron Forge.
 */
declare const MAIN_WINDOW_VITE_NAME: string;

/*
 * Handles creating/removing shortcuts on Windows when installing/uninstalling.
 * Keep this near app startup because Squirrel may need to quit the app early.
 */
if (require('electron-squirrel-startup')) {
  app.quit();
}

/**
 * Registers application-level Inter-Process Communication handlers.
 *
 * These handlers are intentionally small at startup. TMC Desktop must expose
 * only explicit actions to the renderer instead of generic Node.js access.
 */
function registerIpcHandlers(): void {
  ipcMain.handle('tmc:ping', async () => {
    return 'pong';
  });
}

/**
 * Creates the main TMC Desktop window.
 */
function createWindow(): void {
  const mainWindow = new BrowserWindow({
    width: 1100,
    height: 720,
    minWidth: 900,
    minHeight: 560,
    title: 'Twitch Mini Chat Desktop',
    backgroundColor: '#111827',
    webPreferences: {
      preload: path.join(__dirname, 'preload.js'),
      nodeIntegration: false,
      contextIsolation: true,
      sandbox: true,
      webSecurity: true,
    },
  });

  if (MAIN_WINDOW_VITE_DEV_SERVER_URL) {
    void mainWindow.loadURL(MAIN_WINDOW_VITE_DEV_SERVER_URL);
  } else {
    void mainWindow.loadFile(
      path.join(__dirname, `../renderer/${MAIN_WINDOW_VITE_NAME}/index.html`),
    );
  }
}

app.on('ready', () => {
  registerIpcHandlers();
  createWindow();
});

app.on('window-all-closed', () => {
  /*
   * macOS apps usually stay active until the user quits explicitly.
   */
  if (process.platform !== 'darwin') {
    app.quit();
  }
});

app.on('activate', () => {
  /*
   * Re-create the window on macOS when the dock icon is clicked and no windows
   * are currently open.
   */
  if (BrowserWindow.getAllWindows().length === 0) {
    createWindow();
  }
});

.tmc-auth-panel {
  gap: 0.75rem;
}

.tmc-auth-actions {
  display: grid;
  gap: 0.65rem;
}

.tmc-field-label {
  font-size: 0.82rem;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.78);
}

.tmc-text-input {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 0.6rem;
  padding: 0.6rem 0.7rem;
  background: rgba(0, 0, 0, 0.24);
  color: #ffffff;
  outline: none;
}

.tmc-text-input:focus {
  border-color: rgba(145, 70, 255, 0.86);
  box-shadow: 0 0 0 3px rgba(145, 70, 255, 0.22);
}

.tmc-auth-status {
  min-height: 1.2rem;
  margin: 0;
  font-size: 0.82rem;
  color: rgba(255, 255, 255, 0.72);
}

.tmc-button-secondary {
  background: rgba(255, 255, 255, 0.12);
}